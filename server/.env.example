# 远近通记 - 微信提醒后端配置
# 复制此文件为 .env 并填入真实值

# 微信公众号 AppID（公众号后台 → 开发 → 基本配置）
WECHAT_APPID=你的AppID

# 微信公众号 AppSecret
WECHAT_APPSECRET=你的AppSecret

# 你的微信 OpenID（关注自己的公众号后，在公众号后台用户列表可查）
WECHAT_OPENID=你的OpenID

# 模板消息 ID（公众号后台 → 功能 → 模板消息，申请审批通过后获得）
TEMPLATE_ID=你的模板ID

# API Key（自定义随机字符串，与前端同步配置一致即可）
API_KEY=change-me-to-a-random-string
